---
import { getPageAST } from '../utils/contentProvider.js';
import { fetchAsset } from '../utils/assetFetcher.js';
import { renderTemplate } from '../utils/renderer.js';

// Retrieve slug and query parameters
const { slug } = Astro.params;
const branch = Astro.url.searchParams.get('branch') || undefined;

// Measure performance for our audit log
const startTime = performance.now();

const IMAGE_OPTIMIZER_URL = process.env.IMAGE_OPTIMIZER_URL || 'http://localhost:3002';
const urlsToPreWarm: string[] = [];

// Image optimization helper (routes external JPEGs/PNGs through separate microservice)
function optimizeImageUrl(url: string, width: number = 800): string {
  if (!url) return '';
  const trimmed = url.trim();
  if (trimmed.startsWith('/') || trimmed.endsWith('.svg') || trimmed.includes(IMAGE_OPTIMIZER_URL)) {
    return trimmed;
  }
  const optUrl = `${IMAGE_OPTIMIZER_URL}/?url=${encodeURIComponent(trimmed)}&w=${width}&q=80`;
  urlsToPreWarm.push(optUrl);
  return optUrl;
}

// Generate responsive srcset attribute matching microservice widths
function generateSrcset(url: string, widths: number[]): string {
  if (!url) return '';
  const trimmed = url.trim();
  if (trimmed.startsWith('/') || trimmed.endsWith('.svg')) {
    return '';
  }
  return widths
    .map((w) => {
      const optUrl = `${IMAGE_OPTIMIZER_URL}/?url=${encodeURIComponent(trimmed)}&w=${w}&q=80`;
      urlsToPreWarm.push(optUrl);
      return `${optUrl} ${w}w`;
    })
    .join(', ');
}

// Detect if a string is a whitelisted image URL
function isImageUrl(key: string, value: any): boolean {
  if (typeof value !== 'string') return false;
  const val = value.trim();
  if (!val.startsWith('http://') && !val.startsWith('https://') && !val.startsWith('/')) {
    return false;
  }
  const hasImageExt = /\.(jpg|jpeg|png|webp|svg|gif)(\?.*)?$/i.test(val);
  const isImageKey = /image|logo|background|avatar/i.test(key);
  return hasImageExt || isImageKey;
}

function getOptimizationConfig(key: string) {
  if (/background/i.test(key)) {
    return { defaultWidth: 1400, widths: [480, 800, 1200, 1600, 2000] };
  }
  if (/logo/i.test(key)) {
    return { defaultWidth: 200, widths: [100, 200, 300] };
  }
  return { defaultWidth: 1200, widths: [400, 600, 800, 1200, 1600] };
}

function optimizeImagesInObject(obj: any): any {
  if (obj === null) return obj;

  if (typeof obj === 'string') {
    return obj.replace(/<img([^>]*?)src=["'](https?:\/\/[^"']+)["']/gi, (match, beforeSrc, url) => {
      const config = getOptimizationConfig('image');
      const optimizedUrl = optimizeImageUrl(url, config.defaultWidth);
      const srcset = generateSrcset(url, config.widths);
      let replacement = `<img${beforeSrc}src="${optimizedUrl}"`;
      if (srcset) {
        replacement += ` srcset="${srcset}" sizes="100vw"`;
      }
      return replacement;
    });
  }

  if (typeof obj !== 'object') {
    return obj;
  }

  if (Array.isArray(obj)) {
    return obj.map(item => optimizeImagesInObject(item));
  }

  const result: any = {};
  for (const [key, value] of Object.entries(obj)) {
    if (isImageUrl(key, value)) {
      const config = getOptimizationConfig(key);
      const originalUrl = value as string;
      result[key] = optimizeImageUrl(originalUrl, config.defaultWidth);
      result[`${key}Srcset`] = generateSrcset(originalUrl, config.widths);
    } else {
      result[key] = optimizeImagesInObject(value);
    }
  }
  return result;
}

// 1. Fetch Page Content AST (Stale-While-Revalidate Edge Cache)
const pageContent = await getPageAST(slug || '');
const { metadata, blocks } = pageContent;

// Extract Largest Contentful Paint (LCP) image from the first content block that has one
// (header/footer chrome blocks are skipped — preceding chrome/text-only blocks have no image)
let lcpImageUrl = '';
let lcpImageSrcset = '';
const findFirstImage = (obj: any): { url: string; key: string } | null => {
  if (!obj || typeof obj !== 'object') return null;
  if (Array.isArray(obj)) {
    for (const item of obj) {
      const found = findFirstImage(item);
      if (found) return found;
    }
  } else {
    for (const [key, value] of Object.entries(obj)) {
      if (isImageUrl(key, value)) {
        return { url: value as string, key };
      }
      const found = findFirstImage(value);
      if (found) return found;
    }
  }
  return null;
};

for (const block of blocks || []) {
  if (block.type === 'header' || block.type === 'footer' || !block.data) continue;
  const lcpImg = findFirstImage(block.data);
  if (lcpImg) {
    const config = getOptimizationConfig(lcpImg.key);
    lcpImageUrl = optimizeImageUrl(lcpImg.url, config.defaultWidth);
    lcpImageSrcset = generateSrcset(lcpImg.url, config.widths);
    break;
  }
}

// 2. State storage for request-time dynamic composition
let renderedHtml = '';
let headerHtml = '';
let footerHtml = '';
const loadedCss = new Set<string>();
const loadedJs = new Set<string>();
let aggregatedCss = '';
let aggregatedJs = '';
const jsonLdSchemas: any[] = [];

// Fetch global design system index.css from CDN (utilizing the SWR cache)
let globalCss = '';
try {
  globalCss = await fetchAsset('index.css', branch);
} catch (e: any) {
  console.error('[Renderer] Failed to fetch global index.css from CDN:', e.message);
}

// Helper to extract image URL from cell content if it contains an image tag
function extractUrlFromImgTag(value: string): string {
  if (typeof value !== 'string') return value;
  const match = value.match(/<img[^>]+src=["']([^"']+)["']/i);
  if (match) {
    return match[1].replace(/&amp;/g, '&');
  }
  return value;
}

// 3. Loop through blocks and stitch HTML, CSS, and JS components
for (const block of blocks) {
  const { type } = block;
  const data = optimizeImagesInObject(block.data || {});

  // Extract raw URL for background images to avoid inline img tag in CSS
  for (const key of Object.keys(data)) {
    if (/background|bg/i.test(key) && typeof data[key] === 'string' && data[key].includes('<img')) {
      data[key] = extractUrlFromImgTag(data[key]);
    }
  }

  try {
    // A. Fetch HTML layout from Edge CDN
    const htmlTemplate = await fetchAsset(`${type}.html`, branch);

    // B. Interpolate variables and append to page body.
    // Header/footer blocks render outside <main> as page chrome.
    const blockHtml = renderTemplate(htmlTemplate, data);
    if (type === 'header') {
      headerHtml += `\n<!-- Block: ${type} -->\n${blockHtml}`;
    } else if (type === 'footer') {
      footerHtml += `\n<!-- Block: ${type} -->\n${blockHtml}`;
    } else {
      renderedHtml += `\n<!-- Block: ${type} -->\n${blockHtml}`;
    }

    // C. Fetch and cache CSS stylesheet (deduplicated)
    if (!loadedCss.has(type)) {
      try {
        const cssContent = await fetchAsset(`${type}.css`, branch);
        aggregatedCss += `\n/* Component: ${type} */\n${cssContent}`;
        loadedCss.add(type);
      } catch (e) {
        // Optional CSS: component might use global styles only
        console.log(`[Renderer] No style file found for block "${type}"`);
      }
    }

    // D. Fetch optional client-side Vanilla JS script (deduplicated)
    if (!loadedJs.has(type)) {
      try {
        const jsContent = await fetchAsset(`${type}.js`, branch);
        aggregatedJs += `\n/* Script: ${type} */\n${jsContent}`;
        loadedJs.add(type);
      } catch (e) {
        // Optional JS: component might be static
        console.log(`[Renderer] No script file found for block "${type}"`);
      }
    }

    // E. Dynamic Structured Data (JSON-LD) Generation
    if (type.toUpperCase() === 'FAQ') {
      const faqItems = data.items || [];
      const schema = {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqItems.map((item: any) => ({
          "@type": "Question",
          "name": item.question || '',
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer || ''
          }
        }))
      };
      jsonLdSchemas.push(schema);
    } else if (type.toUpperCase() === 'HOWTO') {
      const steps = data.items || [];
      const schema = {
        "@context": "https://schema.org",
        "@type": "HowTo",
        "name": data.sectionTitle || 'Instructional Guide',
        "step": steps.map((item: any, index: number) => ({
          "@type": "HowToStep",
          "position": index + 1,
          "name": item.title || `Step ${index + 1}`,
          "text": item.description || ''
        }))
      };
      jsonLdSchemas.push(schema);
    }
  } catch (err: any) {
    console.error(`[Renderer] Error rendering block "${type}":`, err.message);
    renderedHtml += `\n<div style="padding: 2rem; background: #fee2e2; color: #b91c1c; border: 1px solid #f87171; margin: 1rem 0; border-radius: 4px;">Error rendering block "${type}": ${err.message}</div>`;
  }
}

// Asynchronously pre-warm the image optimizer cache for all collected image URLs
if (urlsToPreWarm.length > 0) {
  const INTERNAL_IMAGE_OPTIMIZER_URL = process.env.INTERNAL_IMAGE_OPTIMIZER_URL || 'http://image-optimizer:3002';
  urlsToPreWarm.forEach(url => {
    const internalUrl = url.replace(IMAGE_OPTIMIZER_URL, INTERNAL_IMAGE_OPTIMIZER_URL);
    fetch(internalUrl).catch(() => {});
  });
}

// Measure composition performance
const durationMs = performance.now() - startTime;
Astro.response.headers.set('X-Response-Time', `${durationMs.toFixed(2)}ms`);
console.log(`[Render Engine] Dynamic page rendered in ${durationMs.toFixed(2)}ms`);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary SEO Meta Tags -->
  <title>{metadata.title || "Globant Document Platform"}</title>
  
  <!-- Dynamic Meta Injection (SEO, OG, Geo) -->
  {Object.entries(metadata).map(([key, value]) => {
    if (key === 'title' || key === 'theme') return null; // already handled
    
    // OpenGraph tags use property attribute
    if (key.startsWith('og:')) {
      return <meta property={key} content={value} />;
    }
    // Geo position, region, and standard meta tags
    return <meta name={key} content={value} />;
  })}

  <!-- Preconnect to Image Optimizer and Font CDNs -->
  <link rel="preconnect" href={IMAGE_OPTIMIZER_URL} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  {lcpImageUrl && (
    <link 
      rel="preload" 
      as="image" 
      href={lcpImageUrl} 
      imagesrcset={lcpImageSrcset} 
      imagesizes="100vw" 
      fetchpriority="high" 
    />
  )}

  <!-- Asynchronously load Heebo Font CSS (live globant.com typeface; Non-blocking CRP Optimization) -->
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800;900&display=swap" />
  </noscript>

  <!-- Global design system stylesheet (fetched from CDN and inlined for rendering speed) -->
  {globalCss && <style set:html={globalCss}></style>}

  <!-- Dynamic Compiled Aggregated CSS (Inlined for 100/100 LCP Performance) -->
  {aggregatedCss && <style set:html={aggregatedCss}></style>}

  <!-- Dynamic JSON-LD Structured Data Injection -->
  {jsonLdSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body class={metadata.theme === 'dark' ? 'dark-theme' : 'light-theme'}>

  <!-- Page chrome: header authored in the Google Doc, composed from the CDN header component -->
  <Fragment set:html={headerHtml} />

  <!-- Page Main Content Body -->
  <main>
    <Fragment set:html={renderedHtml} />
  </main>

  <!-- Page chrome: footer authored in the Google Doc, composed from the CDN footer component -->
  <Fragment set:html={footerHtml} />

  <!-- Dynamic Compiled Client-Side Interactivity Script -->
  {aggregatedJs && <script type="text/javascript" set:html={aggregatedJs}></script>}
</body>
</html>

<style is:global>
  /* Global Page Layout Theme overrides */
  .dark-theme {
    background-color: var(--color-bg-dark);
    color: var(--color-text-primary);
  }
  .light-theme {
    background-color: #ffffff;
    color: #111827;
    --color-bg-card: #f3f4f6;
    --color-border: #e5e7eb;
    --color-text-primary: #111827;
    --color-text-secondary: #4b5563;
  }
  /* Restore dark theme variables inside dark sections/containers when parent is light-theme */
  .dark-theme, .dark, [class*="dark"] {
    --color-bg-card: rgba(255, 255, 255, 0.04);
    --color-border: rgba(255, 255, 255, 0.12);
    --color-text-primary: #ffffff;
    --color-text-secondary: #b0b8c1;
  }
</style>
